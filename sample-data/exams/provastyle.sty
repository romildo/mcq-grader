% --- GRADE DE MATRÍCULA ---
\ExplSyntaxOn
\newcommand{\PrintRegistrationGrid}[1]{%
  \begingroup
  \setlength{\tabcolsep}{2pt}
  \begin{tabular}{ c *{#1}{c} }
    % & \int_step_inline:nnn {1} {#1} {
    %   \textbf{##1} \int_compare:nNnF {##1} = {#1} { & }
    % } \\
    \textbf{0} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_0} \int_compare:nNnF {##1} = {#1} { & } } \\
    \textbf{1} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_1} \int_compare:nNnF {##1} = {#1} { & } } \\
    \textbf{2} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_2} \int_compare:nNnF {##1} = {#1} { & } } \\
    \textbf{3} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_3} \int_compare:nNnF {##1} = {#1} { & } } \\
    \textbf{4} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_4} \int_compare:nNnF {##1} = {#1} { & } } \\
    \textbf{5} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_5} \int_compare:nNnF {##1} = {#1} { & } } \\
    \textbf{6} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_6} \int_compare:nNnF {##1} = {#1} { & } } \\
    \textbf{7} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_7} \int_compare:nNnF {##1} = {#1} { & } } \\
    \textbf{8} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_8} \int_compare:nNnF {##1} = {#1} { & } } \\
    \textbf{9} & \int_step_inline:nnn {1} {#1} { \ZoneBox{id_##1_9} \int_compare:nNnF {##1} = {#1} { & } } \\
  \end{tabular}
  \endgroup
}
\ExplSyntaxOff

